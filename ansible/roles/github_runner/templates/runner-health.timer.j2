# Managed by ansible/roles/github_runner — do not edit by hand.
[Unit]
Description=Run the GitHub Actions runner health check every {{ health_check_interval }}

[Timer]
# Run shortly after boot too: the DNS failure mode is introduced by Proxmox
# rewriting /etc/resolv.conf during container start.
OnBootSec=2min
OnUnitActiveSec={{ health_check_interval }}
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
